{
  "name": "@tyroneross/replit-migrate",
  "version": "0.1.2",
  "description": "Replit app migration toolkit for web, Vercel, iOS, and macOS moves, with plugin guidance and MCP-backed migration checks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "replit-migrate": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "hooks",
    "agents",
    "commands",
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run build:fixshebang",
    "build:fixshebang": "node -e \"const fs=require('fs');const f='dist/cli/index.js';let c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!')){c='#!/usr/bin/env node\\n'+c;fs.writeFileSync(f,c);}\"",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "mcp": "node dist/mcp/server.js"
  },
  "keywords": [
    "replit",
    "migration",
    "ios",
    "macos",
    "vercel",
    "mcp",
    "plugin"
  ],
  "author": "Tyrone Ross, Jr <46267523+tyroneross@users.noreply.github.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyroneross/replit-migrate.git"
  },
  "homepage": "https://github.com/tyroneross/replit-migrate#readme",
  "bugs": {
    "url": "https://github.com/tyroneross/replit-migrate/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "commander": "^14.0.0",
    "glob": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0"
  }
}
